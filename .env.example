# Copy to .env and adjust. Values here are safe placeholders, not secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Read by both the Prisma CLI (prisma.config.ts) and the running
# application itself (src/db/client.ts, via the pg driver adapter —
# Prisma 7 requires this explicitly in code, it is no longer wired up
# automatically from schema.prisma).
DATABASE_URL=postgresql://user:password@localhost:5432/ai_commerce

# --- Not part of .env: used only as a one-off CLI invocation ---
# The first (and any later) admin account is created by running
# src/scripts/create-admin.ts directly, not through any HTTP endpoint:
#
#   ADMIN_EMAIL=owner@example.com ADMIN_PASSWORD='...' npx tsx src/scripts/create-admin.ts
#
# Deliberately not listed above as regular .env lines: unlike the other
# values here, a real admin password left sitting in a checked-out .env
# file is a credential, not configuration.

# Local product/offer media storage directory
MEDIA_STORAGE_DIR=./data/media

# Optional provider-agnostic shipping tracking gateway
SHIPPING_TRACKING_BASE_URL=
SHIPPING_TRACKING_API_KEY=
