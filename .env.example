# Copy to .env and adjust. Values here are safe placeholders, not secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Read by the Prisma CLI (prisma.config.ts) for `prisma generate` /
# `prisma migrate ...`. Not yet read by the running application itself —
# that wiring happens once the first real model is added.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_commerce

# --- Added in a later task (auth) — not read yet by this slice ---
# JWT_SECRET=
